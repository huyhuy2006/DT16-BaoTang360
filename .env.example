# Docker Compose local-development configuration.
# tools/Initialize-DT16.ps1 generates local values if this file is copied to .env.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
FRONTEND_URL=http://localhost:5173

MYSQL_DATABASE=baotang_ao
MYSQL_USER=baotangso_app
MYSQL_PASSWORD=CHANGE_ME_LOCAL_ONLY
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_LOCAL_ONLY

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=baotang_ao
DB_USERNAME=baotangso_app
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

PYTHON_SERVICE_URL=http://python-service:8001
PYTHON_SERVICE_TOKEN=CHANGE_ME_RANDOM_TOKEN
PYTHON_SERVICE_TIMEOUT=3
VITE_API_BASE_URL=http://localhost:8080/api
VITE_STORAGE_BASE_URL=http://localhost:8080/storage
