# Dependencies and build outputs
/backend/vendor/
/frontend/node_modules/
/frontend/dist/
/frontend/playwright-report/
/frontend/test-results/
/frontend/.vite/
/python-service/.venv/
__pycache__/
*.py[cod]

# Environment secrets: commit examples only
.env
.env.*
!.env.example
!**/.env.example
!backend/.env.testing
!backend/.env.production.example
!frontend/.env.production.example

# Laravel generated files
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/public/storage
/backend/public/hot

# Local / generated data and reports
/database/backup/*.sql
/05_KiemThu/evidence-generated/
/bao-cao-playwright/
/test-results/
/coverage/

# Local IDE/OS and accidental backups
*.bak
*.bak.*
*.old
*.orig
*.tmp
*.swp
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json

# Large recording files are stored separately; keep only URL / instructions.
*.mp4
*.mov
*.mkv

# Keep local testing environment out of Git
/backend/.env.testing

# PHPUnit result cache
backend/.phpunit.result.cache
